{
  "name": "millstadt-tmp",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "lounge:initialize-passwords": "node scripts/initialize-lounge-passwords.mjs",
    "test:elite-protected": "node scripts/verify-elite-protected-areas.mjs",
    "test:financials": "node scripts/test-financials-hub.mjs",
    "test:security": "node scripts/test-security-hardening.mjs && node --import tsx --test scripts/test-webauthn-config.ts && node --import tsx scripts/test-truckcheck-boundary.ts && node --import tsx --test scripts/test-truckcheck-persistence.ts && npm run test:turnstile",
    "test:turnstile": "node --import tsx --test scripts/test-turnstile.ts",
    "test:truckcheck": "node --import tsx scripts/test-truckcheck-boundary.ts && node --import tsx --test scripts/test-truckcheck-persistence.ts",
    "test:analytics-boundary": "node --import tsx scripts/test-analytics-boundary.ts",
    "test:sports-score-boundary": "node scripts/test-sports-score-boundary.cjs",
    "test:mcs-schedule": "node --import tsx --test scripts/test-mcs-schedule.ts",
    "test:operational": "node --import tsx scripts/test-operational-correctness.ts",
    "test:reports": "node --import tsx scripts/test-email-output.ts && node --import tsx scripts/test-pdf-registry.ts",
    "test:board-private-documents": "node --import tsx --test scripts/test-board-private-documents.ts",
    "test:lounge-board": "node --import tsx scripts/test-lounge-board-boundary.ts",
    "test:public-experience": "node --import tsx scripts/test-public-experience.ts",
    "test:ai-monitor": "node --import tsx --test scripts/test-ai-monitor.ts",
    "typecheck:ai-monitor": "tsc -p tsconfig.ai-monitor.json --pretty false"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "^5.2.8",
    "@neondatabase/serverless": "^1.0.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.1",
    "@types/leaflet": "^1.9.21",
    "@types/nodemailer": "^7.0.11",
    "@types/qrcode": "^1.5.6",
    "@vercel/blob": "^2.3.3",
    "astronomy-engine": "^2.1.19",
    "googleapis": "^171.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.25.0",
    "next": "16.3.1",
    "node-ical": "^0.26.1",
    "nodemailer": "^9.0.5",
    "pdfjs-dist": "5.5.207",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "twilio": "^5.13.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
