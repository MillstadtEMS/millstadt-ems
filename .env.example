MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
REFERENDUM_WORKBOOK_DRIVE_ID=
REFERENDUM_WORKBOOK_ITEM_ID=
REFERENDUM_WORKBOOK_EXPECTED_FOLDER=01. BOD WEBMASTER
REFERENDUM_WORKBOOK_EXPECTED_FILENAME=Millstadt EMS referendum budget web master.xlsx
REFERENDUM_WORKBOOK_EXPECTED_ACCOUNT=millstadtems@gmail.com
BOARD_SYNC_SECRET=

