# ── Testimonials (already in use) ─────────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=
APPROVAL_SECRET=
NEXT_PUBLIC_BASE_URL=https://millstadtems.org

# ── CAD Dispatch System ────────────────────────────────────────────────────

# Google OAuth2 credentials for millstadtcad@gmail.com
# Setup steps:
#   1. Go to https://console.cloud.google.com
#   2. Create a project (or use existing)
#   3. Enable the Gmail API
#   4. Create OAuth2 credentials → Desktop App type
#   5. Download the credentials JSON
#   6. Run this one-time script to get your refresh token:
#
#      node -e "
#        const {google} = require('googleapis');
#        const auth = new google.auth.OAuth2(
#          'YOUR_CLIENT_ID', 'YOUR_CLIENT_SECRET',
#          'urn:ietf:wg:oauth:2.0:oob'
#        );
#        console.log(auth.generateAuthUrl({
#          access_type: 'offline',
#          scope: ['https://www.googleapis.com/auth/gmail.modify']
#        }));
#      "
#
#   7. Open the URL, sign in as millstadtcad@gmail.com, copy the auth code
#   8. Exchange it:
#
#      node -e "
#        const {google} = require('googleapis');
#        const auth = new google.auth.OAuth2(
#          'YOUR_CLIENT_ID', 'YOUR_CLIENT_SECRET',
#          'urn:ietf:wg:oauth:2.0:oob'
#        );
#        auth.getToken('AUTH_CODE_HERE', (err, tokens) => {
#          console.log(tokens);
#        });
#      "
#
#   9. Copy the refresh_token value into GMAIL_REFRESH_TOKEN below

GMAIL_CLIENT_ID=your_google_oauth2_client_id
GMAIL_CLIENT_SECRET=your_google_oauth2_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token_for_millstadtcad_gmail
GMAIL_USER=millstadtcad@gmail.com

# Optional: refine the Gmail search query once Chief 360 email format is known
# Example: 'from:dispatch@chief360.com is:unread'
# Default: 'is:unread in:inbox'
GMAIL_SEARCH_QUERY=is:unread in:inbox

# Secret to protect the /api/cad/poll endpoint from unauthorized triggers
# Generate with: openssl rand -hex 32
CAD_POLL_SECRET=generate_a_random_secret_here

